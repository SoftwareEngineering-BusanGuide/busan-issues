# 외부 API 키. 실제 값은 .env에 넣고 커밋하지 않는다. (키가 없는 기능은 화면에서 숨겨지고 서버는 그대로 실행된다)

# 공공데이터포털: 기상청 단기예보, 에어코리아 대기오염정보
DATA_GO_KR_API_KEY=
# 재난안전데이터공유플랫폼: 긴급재난문자 (등록한 IP에서만 호출 가능)
SAFETY_DATA_API_KEY=
# NAVER API HUB (네이버 클라우드 플랫폼): 뉴스 검색, 지역 검색
NCP_CLIENT_ID=
NCP_CLIENT_SECRET=
# LLM
GEMINI_API_KEY=
OPENAI_API_KEY=
KAKAO_REST_API_KEY=

# Backend (비워 두면 기본값 사용, backend/README.md 참고)
DATABASE_URL=
CORS_ORIGINS=
# 뉴스 수집 파이프라인 (기본: 켜짐, 30분 간격, 최근 28일, 한 번에 300건, gemini-3.5-flash-lite)
PIPELINE_ENABLED=
PIPELINE_INTERVAL_MINUTES=
NEWS_MAX_AGE_DAYS=
PIPELINE_MAX_PER_RUN=
GEMINI_MODEL=
